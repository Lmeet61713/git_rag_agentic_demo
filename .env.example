# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:8000/api/auth/callback

# Session and secret storage
SESSION_SECRET=change-me
APP_SECRET_KEY=change-me

# Local paths
DATA_DIR=data
CHROMA_DIR=storage/chroma
# 留空时使用 data/models/bge-small-zh-v1.5/onnx/model.onnx
EMBEDDING_MODEL_PATH=
EMBEDDING_BATCH_SIZE=32
SEARCH_MIN_SCORE=0.25
SEARCH_TOP1_GAP=0.15

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# Alibaba Cloud DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=
DASHSCOPE_VL_MODEL=

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODELS_DIR=E:/mmmmmmmmmmmmmmmm/ollama_cache/manifests/registry.ollama.ai/library

# Frontend
# 前端必须通过 http://127.0.0.1:5173 访问，不要使用 localhost，否则 OAuth state 会话不一致。
FRONTEND_ORIGIN=http://127.0.0.1:5173
# 登录请求会直接打到后端，确保 OAuth session cookie 始终落在 127.0.0.1。
VITE_API_ORIGIN=http://127.0.0.1:8000
